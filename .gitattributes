# Keep shell scripts LF-only. scripts/bootstrap.sh is read at synth time and spliced
# (via Fn.rawString) into EC2 user_data; a CRLF here (this repo has core.autocrlf=true)
# would pass through rawString's escaping unchanged and reach the instance, corrupting
# the shebang and breaking the script on Linux.
*.sh text eol=lf
