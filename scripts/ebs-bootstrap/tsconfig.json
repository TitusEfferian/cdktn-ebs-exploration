{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "lib": ["ES2023"],
    "noEmit": true,
    "declaration": false,
    "incremental": false
  },
  "include": ["**/*.ts"],
  // Override the root's `exclude` (which lists scripts/ebs-bootstrap for its own
  // CommonJS build); inherited, it would resolve to this directory and leave no inputs.
  "exclude": ["node_modules", "dist"]
}
